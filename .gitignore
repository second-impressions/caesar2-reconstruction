# Devenv
.devenv*
devenv.local.nix

# direnv
.direnv

# pre-commit
.pre-commit-config.yaml

# Roo/MCP config
.roo/

# Python
.venv/
__pycache__/
*.pyc
.ruff_cache/

# Install directory (game assets copied from an extracted CD; used by the
# DOSBox-X / podman smoke tests — see README "Running the game")
install/

# Local Ghidra projects (ad-hoc RE; nothing in the repo depends on them)
project/
*.gpr
*.rep/
*.lock
*.lock~
!uv.lock
!flake.lock

# The original executable (supply via 'c2 fetch-original'; hash pinned in
# reccmp-project.yml) + machine-local reccmp configs
original/
reccmp-user.yml
reccmp-build.yml

# Scratch / temp files
tmp/
*.err

# c2 build caches
.c2-cache/

# Local credentials
.env
.env.*

# Nix build result symlink and stray object files
/result
*.o

# The functional rebuild (reproducible via 'c2 rebuild'; embeds delinked RAD/Miles code)
build/

# win-verify scratch objects
_objs/
